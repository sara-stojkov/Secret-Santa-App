# SMTP nalog sa kog se šalju mejlovi.
# Podrazumevano je Gmail (smtp.gmail.com, port 465).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=stojkoovs@gmail.com
# Za Gmail ovo NIJE tvoja obična lozinka nego "App password" (vidi README).
SMTP_PASS=

# Ime koje primaoci vide kao pošiljaoca
SENDER_NAME=Tajni Deda Mraz

# Opciono: adresa u "From" ako je drugačija od SMTP_USER
# SMTP_FROM=

# Lozinka koju unosiš u formu pre slanja. Preporučeno, da niko drugi
# ne bi mogao da šalje mejlove sa tvog naloga.
APP_PASSWORD=
